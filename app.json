{
  "expo": {
    "name": "TaskMate",
    "slug": "taskmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taskmate",
    "userInterfaceStyle": "automatic",
    "sdkVersion": "57.0.0",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.taskmate.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermissionText": "TaskMate memerlukan akses kamera untuk memotret tugas atau catatan."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
